# Copy to .env for local development: cp .env.example .env

# --- Core ---
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed origins for the admin console / public web app(s)
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- Data ---
# Local Postgres for development. In production this is Neon (neon.tech), not Render's own
# Postgres — use a project's *direct* (non-pooled, no "-pooler" in the hostname) connection string,
# since this app already manages its own connection pool (db/client.ts). Must include
# ?sslmode=require, which Neon's connection strings already do by default.
DATABASE_URL=postgres://lifecome:lifecome@localhost:5432/lifecome_dev
REDIS_URL=redis://localhost:6379

# --- Auth ---
SESSION_JWT_SECRET=dev-only-change-me
# Signs the operations-console staff JWT — see src/common/auth/. Separate from SESSION_JWT_SECRET
# on purpose (that one only hashes patient OTP codes).
STAFF_JWT_SECRET=dev-only-change-me-too

# --- Operations console bootstrap (npm run db:seed:staff) ---
# Creates the first platform_administrator so someone can sign in and create the rest via the API.
# Change the password immediately in any shared environment.
SEED_ADMIN_EMAIL=admin@lifecomelive.com
SEED_ADMIN_PASSWORD=change-me-immediately
SEED_ADMIN_NAME=Platform Administrator

# --- SMS (OTP delivery) ---
# httpSMS (httpsms.com) — sends via a real Android phone running the httpSMS app, not a telecom
# aggregator. Without both of these set, OTP requests just log the code instead of sending it
# (see src/common/sms/sms.service.ts). HTTPSMS_FROM_NUMBER is that phone's own number, in E.164
# (e.g. +2348012345678) — get the API key from https://httpsms.com/settings after installing the
# app on the phone.
# HTTPSMS_API_KEY=
# HTTPSMS_FROM_NUMBER=

# --- Email ---
# Brevo (brevo.com) transactional email. Without both of these set, emails just log instead of
# sending (see src/common/email/email.service.ts). BREVO_SENDER_EMAIL must be a verified sender in
# the Brevo account (Settings → Senders) or sends are rejected.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=

# --- Keep-alive pinger (npm run keep-alive) — not read by the app itself ---
# PING_URL=https://your-app.onrender.com/api/v1/health/live
# PING_INTERVAL_MS=10000

# --- Integrations (all optional in development; each service degrades or stubs without one) ---
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# TERMII_API_KEY=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
