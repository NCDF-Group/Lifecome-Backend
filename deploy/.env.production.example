# Copy to deploy/.env.production (gitignored) and fill in. Upload with: ./deploy/deploy.sh --push-env
# Lives on the server at /opt/lifecome-api/deploy/.env.production (chmod 600 - deploy.sh sets it).
# NODE_ENV, PORT and REDIS_URL are set by docker-compose.prod.yml - don't set them here.

LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API. Nothing browser-side calls it today
# (the admin console's requests run server-side), so this can stay as-is until one does.
CORS_ORIGIN=http://localhost:3000

# --- Database -------------------------------------------------------------------------------
# Option A (default): keep Neon. The direct, non-pooled connection string, with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# Option B: Postgres on this server (also set COMPOSE_PROFILES=local-db when deploying, via
# deploy.sh's USE_LOCAL_DB=1). No sslmode here - it's a private compose-network connection.
# POSTGRES_PASSWORD=change-me-long-random
# DATABASE_URL=postgresql://lifecome:change-me-long-random@postgres:5432/lifecome

# --- Secrets --------------------------------------------------------------------------------
# Copy BOTH values from the Render dashboard (Environment tab) so signed-in patients and staff
# stay signed in after the move. For a fresh start instead: openssl rand -hex 32
SESSION_JWT_SECRET=
STAFF_JWT_SECRET=

# --- Email (Brevo) --------------------------------------------------------------------------
# BREVO_SENDER_EMAIL must be a verified sender in Brevo (Settings -> Senders).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LifeCome Live

# --- Optional integrations (leave blank until used) -----------------------------------------
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
TERMII_API_KEY=
HTTPSMS_API_KEY=
HTTPSMS_FROM_NUMBER=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# --- First admin account --------------------------------------------------------------------
# Only needed once, for a fresh database (the account already exists if you're staying on Neon):
#   ssh <server> "cd /opt/lifecome-api/deploy && docker compose -f docker-compose.prod.yml exec api node dist/db/seed-staff.js"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Administrator
